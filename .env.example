# Variables lues par docker-compose.yml. Copier ce fichier vers .env (jamais commité).

# Clé qui signe les jetons de connexion. Générer avec : openssl rand -hex 32
SECRET_KEY=

# Compte administrateur de MongoDB. Sur une base neuve, l'image le crée au premier
# démarrage ; ensuite, ces deux variables imposent l'authentification.
MONGO_ROOT_USER=
MONGO_ROOT_PASSWORD=

# Adresse de la base vue par l'API, identifiants compris. En production, l'API a
# son propre compte, limité à la base pokedex (authSource=pokedex). Sur une base
# neuve, le compte administrateur ci-dessus convient :
#   mongodb://<utilisateur>:<mot de passe>@pokedex-db:27017/pokedex?authSource=admin
MONGO_URI=
